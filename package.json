{
    "name": "wheelver",
    "version": "1.0.0",
    "description": "A collection website for HotWheels Collectors",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc && cp -r src/views dist/views",
        "start": "node dist/server.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SillySoon/wheelver.git"
    },
    "keywords": [],
    "author": "SillySoon<silly@sillysoon.de>",
    "license": "MIT",
    "type": "commonjs",
    "bugs": {
        "url": "https://github.com/SillySoon/wheelver/issues"
    },
    "homepage": "https://github.com/SillySoon/wheelver#readme",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cookie-signature": "^1.1.2",
        "@types/ejs": "^3.1.5",
        "@types/express": "^5.0.6",
        "@types/express-session": "^1.18.2",
        "@types/mongoose": "^5.11.96",
        "@types/node": "^25.2.1",
        "@types/passport": "^1.0.17",
        "@types/passport-oauth2": "^1.8.0",
        "@types/supertest": "^7.2.1",
        "cookie-signature": "^1.2.2",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.13.0",
        "mongodb-memory-server-core": "^11.3.0",
        "prettier": "^3.9.9",
        "supertest": "^7.3.1",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.71.0",
        "vitest": "^5.0.3"
    },
    "dependencies": {
        "connect-mongo": "^6.0.0",
        "discord-strategy": "^2.5.0",
        "dotenv": "^17.2.4",
        "ejs": "^4.0.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.0",
        "express-session": "^1.19.0",
        "helmet": "^8.1.0",
        "mongoose": "^9.1.6",
