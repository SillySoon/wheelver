<article class="e-hotwheel-card"
    data-name="<%= hotwheel.name.toLowerCase() %>"
    data-toy-number="<%= (hotwheel.toyNumber || '').toLowerCase() %>"
    data-series="<%= (hotwheel.series && hotwheel.series.name) ? hotwheel.series.name.toLowerCase() : '' %>"
    data-year="<%= hotwheel.year || 0 %>"
    data-extra="<%= hotwheel.extra || 'Regular' %>"
    data-collected-at="<%= locals.collectedAt ? new Date(collectedAt).getTime() : 0 %>"
    data-count="<%= locals.count ? count : 1 %>"
>
    <div class="e-hotwheel-card__image-wrapper">
        <img src="<%= hotwheel.photoUrl || '/images/default.jpg' %>" alt="<%= hotwheel.name %>" class="e-hotwheel-card__img">

        <% if (hotwheel.extra && hotwheel.extra !== 'Regular') { %>
            <span class="e-hotwheel-card__badge e-hotwheel-card__badge--extra e-hotwheel-card__badge--<%= hotwheel.extra.toLowerCase().replace(/ /g, '-') %>">
                <%= hotwheel.extra === 'Treasure Hunt' ? 'TH' : hotwheel.extra === 'Super Treasure Hunt' ? 'STH' : hotwheel.extra %>
            </span>
        <% } %>

        <% if (locals.count && count > 1) { %>
            <span class="e-hotwheel-card__badge e-hotwheel-card__badge--count">×<%= count %></span>
        <% } %>
    </div>

    <div class="e-hotwheel-card__info">
        <% if (locals.isDashboardView) { %>
            <p class="e-hotwheel-card__name"><%= hotwheel.name %></p>
        <% } else { %>
            <a href="/hw/<%= hotwheel._id %>" class="a-link e-hotwheel-card__name"><%= hotwheel.name %></a>
        <% } %>

        <div class="e-hotwheel-card__meta">
            <span class="text--muffled"><%= (hotwheel.series && hotwheel.series.name) ? hotwheel.series.name : 'Unknown Series' %></span>
            <span class="e-hotwheel-card__toy-number"><%= hotwheel.toyNumber || 'N/A' %></span>
        </div>

        <% if (locals.isDashboardView) { %>
            <button class="a-button remove-hotwheel-btn" data-id="<%= hotwheel._id %>" data-collection-id="<%= collection._id %>">Remove</button>
        <% } %>
    </div>
</article>
