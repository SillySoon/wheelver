<header class="m-header <%= locals.headerClass || '' %>" style="<%= locals.headerStyle || '' %>">
    <div class="m-header__wrapper">
        <% if (!locals.noLogo) { %>
            <a class="a-logo" href="/">Wheelver</a>
        <% } %>
        <% if (!locals.noNavLinks) { %>
            <nav class="e-navigation">
                <ul class="e-navigation__list">
                    <li class="e-navigation__item">
                        <a class="a-link" href="https://discord.gg/G56NuyyFjs">Discord</a>
                    </li>
                </ul>
            </nav>
        <% } %>
    </div>
    <div class="m-header__wrapper">
        <% if (!locals.noSearch) { %>
            <form action="/" method="GET" class="a-search" data-user-search>
                <input type="text" name="search" class="a-search__input" placeholder="Search...">
                <div class="a-search__results" style="display: none;"></div>
            </form>
        <% } %>
        <div id="auth-links">
            <% if (locals.authUser) { %>
                <a href="/dashboard" id="dashboard-link">
                    <button class="a-button">Dashboard</button>
                </a>
                <form action="/auth/logout" method="POST" class="m-header__logout">
                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                    <button type="submit" class="a-button">Logout</button>
                </form>
            <% } else { %>
                <a href="/auth/login" id="login-link">
                    <button class="a-button">Login</button>
                </a>
            <% } %>
        </div>
    </div>
</header>
<script src="/js/user-search.js"></script>