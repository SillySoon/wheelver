<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', {
        metaTitle: 'Wheelver - Register',
        metaDescription: 'Create your Wheelver account and start sharing your Hot Wheels collection.'
    }) %>
</head>
<body>
    <div class="content-wrapper">
        <%- include('../partials/header') %>
        <section class="m-jumbotron">
            <h1 class="m-jumbotron__title">Welcome to Wheelver!</h1>
            <p class="m-jumbotron__description">Please choose a username to complete your registration.</p>
            <form id="username-form" class="a-search" action="/auth/register" method="POST">
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                <div>
                    <input class="a-search__input" type="text" id="username" name="username" required minlength="3" maxlength="20" placeholder="Enter your username">
                </div>
                <div id="error-message" class="error"></div>
            </form>

            <button type="submit" form="username-form" class="a-button">Complete Registration</button>
        </section>
    </div>
    <script src="/js/register.js"></script>
</body>
</html>