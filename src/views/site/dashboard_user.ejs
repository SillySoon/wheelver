<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', {
        metaTitle: 'Account - Wheelver',
        metaDescription: 'Manage your Wheelver account.'
    }) %>
</head>
<body>
<div class="content-wrapper">
    <%- include('../partials/header') %>
    <main>
        <section class="m-jumbotron">
            <h1 class="m-jumbotron__title">Account</h1>
            <p class="m-jumbotron__description">Your name and handle are taken from Discord and update every time you log in.</p>

            <div class="e-stats">
                <div class="e-stats__item">
                    <p class="text--muffled">Name</p>
                    <span class="text"><%= authUser.displayName %></span>
                </div>
                <div class="e-stats__item">
                    <p class="text--muffled">Handle</p>
                    <span class="text">@<%= authUser.handle %></span>
                </div>
                <div class="e-stats__item">
                    <p class="text--muffled">Discord ID</p>
                    <span class="text"><%= authUser.discordId %></span>
                </div>
            </div>

            <div id="error-message" class="error"></div>
            <a href="/dashboard" class="m-jumbotron__example a-link">Return to Dashboard</a>

            <div class="m-danger-zone">
                <h2>Delete Account</h2>
                <p class="text--muffled">Permanently deletes your account and all of your collections. This cannot be undone.</p>
                <button type="button" id="delete-account-btn" class="a-button a-button--danger" data-user-id="<%= authUser._id %>">Delete Account</button>
            </div>
        </section>
        <script src="/js/edit-user.js"></script>
    </main>
</div>
</body>
</html>
