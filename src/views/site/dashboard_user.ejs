<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', {
        metaTitle: 'Edit Profile - Wheelver',
        metaDescription: 'Edit your Wheelver profile.'
    }) %>
</head>
<body>
<div class="content-wrapper">
    <%- include('../partials/header') %>
    <main>
        <section class="m-jumbotron">
            <h1 class="m-jumbotron__title">Edit Profile</h1>
            <p class="m-jumbotron__description">Change your Profile settings</p>
            <div id="error-message" class="error"></div>
            <form id="edit-user-form">
                <div>
                    <label for="username">Username:</label>
                    <input type="text" id="username" name="username" required
                           pattern="^[a-zA-Z0-9_]{3,20}$"
                           title="Username must be 3-20 characters long and contain only letters, numbers, and underscores."
                           minlength="3" maxlength="20"
                           class="a-search__input"
                    >
                </div>
            </form>
            <div>
                <p>Discord ID: <span id="discord-id"></span></p>
            </div>
            <button form="edit-user-form" type="submit" class="a-button">Save Changes</button>
            <a href="/dashboard" class="m-jumbotron__example a-link">Return to Dashboard</a>

            <div class="m-danger-zone">
                <h2>Delete Account</h2>
                <p class="text--muffled">Permanently deletes your account and all of your collections. This cannot be undone.</p>
                <button type="button" id="delete-account-btn" class="a-button a-button--danger">Delete Account</button>
            </div>
        </section>
        <script src="/js/edit-user.js"></script>
    </main>
</div>
</body>
</html>
