<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', {
        metaTitle: (user ? user.displayName + ' - Wheelver' : 'Wheelver'),
        metaDescription: user
            ? user.displayName + ' has ' + collections.length + ' collection' + (collections.length !== 1 ? 's' : '') + ' on Wheelver.'
            : 'View Hot Wheels collections on Wheelver.',
        metaUrl: locals.currentUrl || 'https://wheelver.sillysoon.de'
    }) %>
</head>
<body>
<div class="content-wrapper">
    <%- include('../partials/header', { headerClass: 'm-header--colorful', noNavLinks: true }) %>
    <main class="l-container">
        <% if (error) { %>
            <section class="m-jumbotron">
                <h1 class="m-jumbotron__title">Error</h1>
                <p class="m-jumbotron__description"><%= error %></p>
            </section>
        <% } else if (user) { %>
            <%
                const totalCars = collections.reduce((sum, c) => sum + (typeof c.itemCount !== 'undefined' ? c.itemCount : (c.items ? c.items.length : 0)), 0);
                const allEntries = collections.flatMap(c => c.items || []);
                const allSeriesIds = new Set(allEntries.filter(e => e.hotwheel && e.hotwheel.series).map(e => e.hotwheel.series._id ? e.hotwheel.series._id.toString() : e.hotwheel.series.toString()));
                const totalSpecial = allEntries.filter(e => e.hotwheel && e.hotwheel.extra && e.hotwheel.extra !== 'Regular').length;
            %>
            <section class="m-user-info">
                <h1><%= user.displayName %></h1>
                <p class="text--muffled">@<%= user.handle %></p>
                <div class="e-stats">
                    <div class="e-stats__item">
                        <p class="text--muffled">Collections</p>
                        <span class="text"><%= collections.length %></span>
                    </div>
                    <div class="e-stats__item">
                        <p class="text--muffled">Hotwheels</p>
                        <span class="text"><%= totalCars %></span>
                    </div>
                    <% if (allSeriesIds.size > 0) { %>
                    <div class="e-stats__item">
                        <p class="text--muffled">Series</p>
                        <span class="text"><%= allSeriesIds.size %></span>
                    </div>
                    <% } %>
                    <% if (totalSpecial > 0) { %>
                    <div class="e-stats__item">
                        <p class="text--muffled">Special</p>
                        <span class="text"><%= totalSpecial %></span>
                    </div>
                    <% } %>
                    <div class="e-stats__item">
                        <p class="text--muffled">Joined</p>
                        <span class="text"><%= new Date(user.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                    </div>
                </div>
            </section>

            <section class="m-collection">
                <div class="m-collection__header">
                    <h2>Collections</h2>
                    <button id="share-button" class="a-button">Share</button>
                </div>

                <div class="m-collection__grid">
                    <% if (collections && collections.length > 0) { %>
                        <% collections.forEach(collection => { %>
                            <%- include('../partials/e-collection-card', { collection }) %>
                        <% }); %>
                    <% } else { %>
                        <div class="m-collection__empty">
                            <p>No collections yet.</p>
                        </div>
                    <% } %>
                </div>
            </section>
        <% } %>
    </main>
    <script src="/js/share.js"></script>
</div>
</body>
</html>
