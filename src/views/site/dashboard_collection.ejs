<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', {
        metaTitle: (collection ? 'Edit ' + collection.name : 'Edit Collection') + ' - Wheelver',
        metaDescription: 'Edit your Hot Wheels collection on Wheelver.'
    }) %>
</head>
<body>
<div class="content-wrapper">
    <%- include('../partials/header', { headerClass: 'm-header--colorful', noNavLinks: true }) %>
    <main class="l-container" data-collection-id="<%= collection && collection._id ? collection._id : '' %>">
        <% if (error) { %>
            <section class="m-jumbotron">
                <h2 class="m-jumbotron__title">Error</h2>
                <p class="m-jumbotron__description"><%= error %></p>
            </section>
        <% } else if (collection) { %>
            <%
                const total = collection.items ? collection.items.length : 0;
                const seriesSet = new Set(collection.items ? collection.items.filter(e => e.hotwheel && e.hotwheel.series).map(e => e.hotwheel.series._id ? e.hotwheel.series._id.toString() : e.hotwheel.series.toString()) : []);
                const specialCount = collection.items ? collection.items.filter(e => e.hotwheel && e.hotwheel.extra && e.hotwheel.extra !== 'Regular').length : 0;
            %>

            <section class="m-user-info">
<h1><%= collection.name %></h1>
                <div class="e-stats">
                    <div class="e-stats__item">
                        <p class="text--muffled">Hotwheels</p>
                        <span class="text"><%= total %></span>
                    </div>
                    <div class="e-stats__item">
                        <p class="text--muffled">Series</p>
                        <span class="text"><%= seriesSet.size %></span>
                    </div>
                    <% if (specialCount > 0) { %>
                    <div class="e-stats__item">
                        <p class="text--muffled">Special</p>
                        <span class="text"><%= specialCount %></span>
                    </div>
                    <% } %>
                </div>

                <form id="edit-collection-form" class="m-collection__form">
                    <input type="text" id="collection-name" name="name" value="<%= collection.name %>" required
                           pattern="^[a-zA-Z0-9\-_& ]+$"
                           title="Only letters, numbers, spaces, -, _, and & are allowed."
                           class="a-search__input">
                    <button type="submit" class="a-button">Rename</button>
                </form>

                <div id="form-error-message" class="error"></div>

                <div class="m-collection__header-actions">
                    <a href="/c/<%= collection._id %>" class="a-button">View as public</a>
                    <button id="delete-collection-btn" class="a-button a-button--danger">Delete collection</button>
                </div>
            </section>

            <section class="m-collection">
                <h2>Hot Wheels in this Collection</h2>

                <div class="m-hw-add">
                    <div class="m-hw-add__search-side">
                        <div class="a-search" style="max-width: none;">
                            <input type="text" id="hw-search-input" class="a-search__input a-search--large" placeholder="Search by name or toy number...">
                            <div id="hw-search-results" class="a-search__results"></div>
                        </div>
                    </div>

                    <div class="m-hw-add__preview" id="hw-preview">
                        <p class="m-hw-add__placeholder text--muffled">Search for a Hot Wheel to preview it here.</p>
                    </div>
                </div>

                <div class="m-collection__controls" id="list-controls"<% if (!collection.items || collection.items.length === 0) { %> style="display:none"<% } %>>
                    <input type="text" id="hw-filter-search" class="a-search__input" placeholder="Filter list...">
                    <div class="m-collection__pills">
                        <button class="a-pill a-pill--active" data-extra="all">All</button>
                        <button class="a-pill" data-extra="Treasure Hunt">TH</button>
                        <button class="a-pill" data-extra="Super Treasure Hunt">STH</button>
                        <button class="a-pill" data-extra="Chase">Chase</button>
                    </div>
                    <select id="hw-sort" class="a-select">
                        <option value="collected-desc">Recently collected</option>
                        <option value="name-asc">Name A–Z</option>
                        <option value="name-desc">Name Z–A</option>
                        <option value="year-desc">Year newest</option>
                        <option value="year-asc">Year oldest</option>
                    </select>
                </div>

                <ul class="m-hw-list" id="hw-list">
                    <li class="m-hw-list__header">
                        <span></span>
                        <span>Name</span>
                        <span>Series</span>
                        <span>Toy #</span>
                        <span>Collected</span>
                        <span></span>
                    </li>
                    <% if (!collection.items || collection.items.length === 0) { %>
                        <li class="m-hw-list__empty" id="hw-empty">No hotwheels in this collection yet.</li>
                    <% } else { %>
                        <% collection.items.forEach(entry => { %>
                            <%- include('../partials/e-hotwheel-row', { hotwheel: entry.hotwheel, entry, collection }) %>
                        <% }); %>
                    <% } %>
                </ul>
                <p id="hw-no-results" style="display:none;" class="text--muffled">No hotwheels match your filter.</p>
            </section>
        <% } %>
    </main>
    <script src="/js/edit-collection.js"></script>
    <script src="/js/dashboard-filter.js"></script>
</div>
</body>
</html>
