<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', {
        metaTitle: (hotwheel ? hotwheel.name + ' - Wheelver' : 'Wheelver'),
        metaDescription: hotwheel
            ? hotwheel.name + (hotwheel.year ? ' · ' + hotwheel.year : '') + (hotwheel.series && hotwheel.series.name ? ' · ' + hotwheel.series.name : '') + ' - Hot Wheels on Wheelver.'
            : 'Hot Wheels details on Wheelver.',
        metaUrl: hotwheel ? 'https://wheelver.sillysoon.de/hw/' + hotwheel._id : 'https://wheelver.sillysoon.de',
        metaImage: hotwheel && hotwheel.photoUrl ? hotwheel.photoUrl : undefined
    }) %>
</head>
<body>
<div class="content-wrapper">
    <%- include('../partials/header', { headerClass: 'm-header--colorful', noNavLinks: true }) %>
    <main>
        <% if (error) { %>
            <section class="m-jumbotron">
                <h1 class="m-jumbotron__title">Error</h1>
                <p class="m-jumbotron__description"><%= error %></p>
            </section>
        <% } else if (hotwheel) { %>
            <section class="m-user-info">
                <div class="m-hotwheel-detail__title">
                    <h1><%= hotwheel.name %></h1>
                    <% if (hotwheel.extra && hotwheel.extra !== 'Regular') { %>
                        <span class="e-hotwheel-card__badge e-hotwheel-card__badge--extra e-hotwheel-card__badge--<%= hotwheel.extra.toLowerCase().replace(/ /g, '-') %> m-hotwheel-detail__badge">
                            <%= hotwheel.extra %>
                        </span>
                    <% } %>
                </div>
            </section>

            <div class="m-hotwheel-detail">
                <div class="m-hotwheel-detail__image-wrapper">
                    <img src="<%= hotwheel.photoUrl || '/images/default.jpg' %>" alt="<%= hotwheel.name %>" class="m-hotwheel-detail__img">
                </div>

                <div class="m-hotwheel-detail__content">
                    <h2>Specifications</h2>
                    <div class="m-hotwheel-detail__info-grid">
                        <div class="m-hotwheel-detail__label">Series</div>
                        <div class="m-hotwheel-detail__value"><%= (hotwheel.series && hotwheel.series.name) ? hotwheel.series.name : 'N/A' %></div>

                        <div class="m-hotwheel-detail__label">Series Number</div>
                        <div class="m-hotwheel-detail__value"><%= hotwheel.seriesNumber || 'N/A' %></div>

                        <div class="m-hotwheel-detail__label">Toy Number</div>
                        <div class="m-hotwheel-detail__value"><%= hotwheel.toyNumber || 'N/A' %></div>

                        <div class="m-hotwheel-detail__label">Collector Number</div>
                        <div class="m-hotwheel-detail__value"><%= hotwheel.colNumber || 'N/A' %></div>

                        <div class="m-hotwheel-detail__label">Year</div>
                        <div class="m-hotwheel-detail__value"><%= hotwheel.year || 'N/A' %></div>
                    </div>
                </div>
            </div>
        <% } %>
    </main>
</div>
</body>
</html>
