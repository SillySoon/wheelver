<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', {
        metaTitle: (collection ? collection.name + ' - Wheelver' : 'Wheelver'),
        metaDescription: collection
            ? (collection.owner && collection.owner.displayName ? collection.owner.displayName + "'s " : '') + 'collection "' + collection.name + '" on Wheelver - ' + (collection.items ? collection.items.length : 0) + ' cars.'
            : 'View Hot Wheels collections on Wheelver.',
        metaUrl: locals.currentUrl || 'https://wheelver.sillysoon.de'
    }) %>
</head>
<body>
<div class="content-wrapper">
    <%- include('../partials/header', { headerClass: 'm-header--colorful', noNavLinks: true }) %>
    <main>
        <% if (error) { %>
            <section class="m-jumbotron">
                <h1 class="m-jumbotron__title">Error</h1>
                <p class="m-jumbotron__description"><%= error %></p>
            </section>
        <% } else if (collection) { %>
            <%
                const total = collection.items ? collection.items.length : 0;
                const seriesSet = new Set(collection.items ? collection.items.filter(e => e.hotwheel && e.hotwheel.series).map(e => e.hotwheel.series._id ? e.hotwheel.series._id.toString() : e.hotwheel.series.toString()) : []);
                const specialCount = collection.items ? collection.items.filter(e => e.hotwheel && e.hotwheel.extra && e.hotwheel.extra !== 'Regular').length : 0;
                const isOwner = currentUser && collection.owner && (collection.owner._id || collection.owner).toString() === currentUser._id.toString();
            %>

            <section class="m-user-info">
                <h1><%= collection.name %></h1>
                <div class="e-stats">
                    <div class="e-stats__item">
                        <p class="text--muffled">Hotwheels</p>
                        <span class="text"><%= total %></span>
                    </div>
                    <div class="e-stats__item">
                        <p class="text--muffled">Series</p>
                        <span class="text"><%= seriesSet.size %></span>
                    </div>
                    <% if (specialCount > 0) { %>
                    <div class="e-stats__item">
                        <p class="text--muffled">Special</p>
                        <span class="text"><%= specialCount %></span>
                    </div>
                    <% } %>
                    <div class="e-stats__item">
                        <p class="text--muffled">Owner</p>
                        <span class="text">
                            <% if (collection.owner && collection.owner.handle) { %>
                                <a href="/u/<%= collection.owner.handle %>" class="a-link text"><%= collection.owner.displayName || 'View Profile' %></a>
                            <% } else { %>
                                Unknown
                            <% } %>
                        </span>
                    </div>
                </div>
            </section>

            <section class="m-collection">
                <div class="m-collection__header">
                    <h2>Hotwheels</h2>
                    <div style="display:flex; gap: 0.5rem;">
                        <% if (isOwner) { %>
                            <a href="/dashboard/c/<%= collection._id %>" class="a-button">Edit</a>
                        <% } %>
                        <button id="share-button" class="a-button">Share</button>
                    </div>
                </div>

                <% if (collection.items && collection.items.length > 0) { %>
                <div class="m-collection__controls">
                    <input type="text" id="hw-filter-search" class="a-search__input" placeholder="Search by name or toy number...">

                    <div class="m-collection__pills">
                        <button class="a-pill a-pill--active" data-extra="all">All</button>
                        <button class="a-pill" data-extra="Treasure Hunt">TH</button>
                        <button class="a-pill" data-extra="Super Treasure Hunt">STH</button>
                        <button class="a-pill" data-extra="Chase">Chase</button>
                    </div>

                    <select id="hw-sort" class="a-select">
                        <option value="collected-desc">Recently collected</option>
                        <option value="name-asc">Name A–Z</option>
                        <option value="name-desc">Name Z–A</option>
                        <option value="year-desc">Year newest</option>
                        <option value="year-asc">Year oldest</option>
                        <option value="count-desc">Most owned</option>
                    </select>
                </div>
                <% } %>

                <div class="m-collection__grid">
                    <% if (collection.items && collection.items.length > 0) { %>
                        <%
                            const countMap = {};
                            const seen = new Set();
                            const uniqueEntries = [];
                            collection.items.forEach(entry => {
                                const id = entry.hotwheel._id.toString();
                                countMap[id] = (countMap[id] || 0) + 1;
                                if (!seen.has(id)) { seen.add(id); uniqueEntries.push(entry); }
                            });
                        %>
                        <% uniqueEntries.forEach(entry => { %>
                            <%- include('../partials/e-hotwheel-card', { hotwheel: entry.hotwheel, count: countMap[entry.hotwheel._id.toString()], collectedAt: entry.acquiredAt }) %>
                        <% }); %>
                    <% } else { %>
                        <p>No Hot Wheels in this collection yet.</p>
                    <% } %>
                </div>

                <p id="hw-no-results" style="display:none;" class="text--muffled">No hotwheels match your search.</p>
            </section>
        <% } %>
    </main>
    <script src="/js/share.js"></script>
    <script src="/js/collection-filter.js"></script>
    <script src="/js/lightbox.js"></script>
</div>
</body>
</html>
